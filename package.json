{
  "name": "plug-nudge-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:rich": "node --test tests/RichNotifications.test.mjs",
    "test:browser:rich": "node tests/browser/richNotifications.mjs",
    "test:browser:history": "node tests/browser/nudgeHistory.mjs",
    "dev": "vite",
    "build": "npm run test:styles && npm run test:pwa && npm run test:seo && vue-tsc -b && vite build && vite build --ssr src/entry-server.ts --outDir build/prerender && node scripts/prerender.mjs && npm run test:seo:built",
    "test:seo": "node --test tests/Seo.test.mjs tests/GoogleAnalytics.test.mjs tests/ServiceWorker.test.mjs tests/Integrations.test.mjs",
    "test:seo:built": "node --test tests/build/Prerender.test.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:charts": "node --test tests/chartGeometry.test.mjs",
    "test:styles": "node --test tests/StyleOwnership.test.mjs",
    "test:pwa": "node --test tests/Pwa.test.mjs",
    "test:browser:styles": "node tests/browser/styleOwnership.mjs",
    "test:api": "node --test tests/ApiClient.test.mjs tests/useNudgeHistory.test.mjs",
    "test:browser:api": "node tests/browser/apiPagination.mjs",
    "test:snackbar": "node --test tests/Snackbar.test.mjs",
    "test:browser:snackbar": "node tests/browser/snackbar.mjs",
    "test:browser:navigation": "node tests/browser/bottomNavigation.mjs",
    "test:browser:pending": "node tests/browser/pendingAccess.mjs",
    "test:browser:mobile": "node tests/browser/mobileNative.mjs",
    "test:browser:public-actions": "node tests/browser/publicActions.mjs",
    "test:compose": "node --test tests/BroadcastComposer.test.mjs tests/NotificationPreview.test.mjs tests/ReviewLayout.test.mjs",
    "test:api-access": "node --test tests/ApiAccess.test.mjs",
    "test:profile": "node --test tests/ProfileDetails.test.mjs tests/profileErrors.test.mjs tests/ProfileLayout.test.mjs tests/AppTheme.test.mjs",
    "test:ui": "node --test tests/PillTabs.test.mjs tests/PageLayout.test.mjs tests/NudgeHistoryPanel.test.mjs tests/Onboarding.test.mjs tests/PendingProfile.test.mjs tests/RouteAccess.test.mjs tests/SetupLogout.test.mjs tests/profileErrors.test.mjs",
    "test:audience": "node --test tests/chartGeometry.test.mjs tests/useAudienceOverview.test.mjs tests/AudienceOverview.test.mjs",
    "test:browser:audience": "node tests/browser/audienceMetrics.mjs",
    "test:browser:marketing": "node tests/browser/marketing.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@newrelic/browser-agent": "^1.323.0",
    "@sentry/vue": "^11.6.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vuetify": "^3.8.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.43",
    "esbuild": "0.28.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vue-tsc": "^2.2.12"
  }
}
