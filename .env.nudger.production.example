# Production browser traffic stays on the frontend origin. Nginx proxies /v1
# requests to the internal-and-cloud-load-balancing API service.
VITE_API_BASE_URL=/
# Internal same-project Cloud Run API origin. The deployment script attaches
# nudger-fe to the production VPC and routes this request internally.
API_PROXY_UPSTREAM=https://nudge-api-uvoscw2dga-el.a.run.app

# Keep these values aligned with the backend profile-image limits.
VITE_PROFILE_IMAGE_SOURCE_MAX_BYTES=10485760
VITE_PROFILE_IMAGE_FINAL_MAX_BYTES=2097152
VITE_PROFILE_IMAGE_MAX_DIMENSION=1600
VITE_PROFILE_IMAGE_WEBP_QUALITY=0.82

# Production-only observability. Keep these blank in local environment files.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_NEW_RELIC_ACCOUNT_ID=0000000
VITE_NEW_RELIC_APPLICATION_ID=000000000
VITE_NEW_RELIC_AGENT_ID=000000000
VITE_NEW_RELIC_LICENSE_KEY=NRJS-xxxxxxxxxxxxxxxxxxxxxxxx
VITE_NEW_RELIC_BEACON=bam.eu01.nr-data.net
VITE_NEW_RELIC_ERROR_BEACON=bam.eu01.nr-data.net
VITE_NEW_RELIC_TRUST_KEY=0000000
