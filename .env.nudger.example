# Runtime values for docker run --env-file. The API is proxied through Nginx.
VITE_API_BASE_URL=/
API_PROXY_UPSTREAM=http://host.docker.internal:8001
VITE_PROFILE_IMAGE_SOURCE_MAX_BYTES=10485760
VITE_PROFILE_IMAGE_FINAL_MAX_BYTES=2097152
VITE_PROFILE_IMAGE_MAX_DIMENSION=1600
VITE_PROFILE_IMAGE_WEBP_QUALITY=0.82
